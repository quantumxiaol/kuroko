# Kuroko — 本地服务用的 API key 都放这里（复制成 .env，.env 不进 git）
# cp .env.example .env

# ---- DeepSeek：对话 / function call ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 设为 1 时走 /beta + strict 工具模式（参数格式更死，但 beta 可能变）
DEEPSEEK_STRICT=0

# ---- Xiaomi MiMo：语音识别（ASR）+ 语音合成（TTS）----
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_ASR_MODEL=mimo-v2.5-asr
MIMO_TTS_MODEL=mimo-v2.5-tts
# 内置音色：mimo_default / 冰糖 / 茉莉 / 苏打 / 白桦 / Mia / Chloe / Milo / Dean
MIMO_TTS_VOICE=冰糖
MIMO_ASR_LANGUAGE=zh

# ---- 本地 bridge（vvvv 轮询这个地址）----
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765
