          <Pad Id="RdlF1xn5PsjN2DIkXuqmo5" Bounds="420,860,620,40" ShowValueBox="true" isIOBox="true" Value="Seven probes span a full row of the 640x480 depth frame (y=320, x=64..576) — anything entering the view side is caught. Move them to taste. If readings flicker at long range, raise Damper Filter Time. Upgrade path: threshold the depth image and take a low percentile instead of point probes.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
