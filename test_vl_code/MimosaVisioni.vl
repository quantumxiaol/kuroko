          <Pad Id="MvYF2QhK2PULeC1ZDOzpgj" Bounds="100,50,640,30" ShowValueBox="true" isIOBox="true" Value="Mimosa Vision i — pure depth proximity (RealSense D435i, no person detection)">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">15</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="MJDMQgXsCuEQIp6A9UTSnP" Bounds="100,88,820,30" ShowValueBox="true" isIOBox="true" Value="Nearest of 5 depth probes on the center row -> Distance (m). Anything entering the interaction zone triggers the shy response. Verify readings with a tape measure at 1m / 2m / 3m, then feed Distance into Mimosa.vl MapClamp Input. HoleFillingFilter fills invalid zero-depth pixels.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>

